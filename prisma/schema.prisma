generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  username    String      @unique
  isAdmin     Boolean     @default(false)
  phoneNumber String?     @default("")
  theme       String      @default("light")
  favorites   String[]    @default([])
  cartItems   String[]    @default([])
  lastLogin   DateTime?
  avatarUrl   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]
  userDetail  UserDetail?
}

model Book {
  id             String      @id @default(uuid())
  title          String
  author         String
  isbn           String      @unique
  publisher      String
  publishedDate  DateTime
  pageCount      Int         @default(0)
  category       String
  price          Float
  discount       Float       @default(0)
  popularity     Int         @default(0)
  availableCount Int         @default(0)
  isNewArticle   Boolean     @default(false)
  isSoldOut      Boolean     @default(false)
  isAvailable    Boolean     @default(true)
  isBestSeller   Boolean     @default(false)
  coverUrl       String?
  description    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  totalAmount Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  bookId   String
  book     Book   @relation(fields: [bookId], references: [id])
  quantity Int
  price    Float // Price at the time of purchase
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model UserDetail {
  id     String @id @default(cuid())
  userId String @unique

  // Personalization
  displayName       String?
  avatarUrl         String?
  bio               String? @db.VarChar(255)
  preferredLanguage String  @default("en")

  // Membership
  isPremium       Boolean   @default(false)
  membershipStart DateTime?
  membershipEnd   DateTime?

  // Normalized Address Fields
  addressLine1  String // House number, Street name
  addressLine2  String? // Apartment, Suite, Unit, Building
  city          String
  stateProvince String? // Essential for US/Canada/Australia/India
  postalCode    String? // Optional because not all countries use them
  countryCode   String // Use ISO 3166-1 alpha-2 (e.g., "US", "SK", "DE")

  // Banking
  iban         String?
  bic          String?
  dateOfBirth  DateTime?
  taxId        String?   @unique
  lastActiveAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model ImageRecord {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  createdAt DateTime @default(now())
}
